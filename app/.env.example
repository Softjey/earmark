# localnet | devnet
NEXT_PUBLIC_CLUSTER=devnet
# optional, defaults to the public RPC of the cluster. Set a Helius/QuickNode devnet URL for the demo:
# the public endpoint answers 429 under load and the first load of a fundraiser page/audit can take 30 s+
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TPLN_MINT=
# Devnet ePLN faucet (T13). JSON byte array of the dedicated faucet key; server-side only, never commit.
# Generate with: pnpm tsx scripts/setup-faucet.ts
FAUCET_SECRET_KEY=
# optional: default whole ePLN per request (default 100; one request may ask for up to 1 000 000) and cap on token accounts the faucet may open (default 40)
FAUCET_AMOUNT=
FAUCET_MAX_NEW_ACCOUNTS=
# optional: Ramp Network host API key (public, free from Ramp's partner dashboard). Shows "Buy with a card" in the
# faucet panel; Ramp refuses to open without it. URL defaults to Ramp's demo env, asset to devnet SOL (for fees).
NEXT_PUBLIC_RAMP_API_KEY=
NEXT_PUBLIC_RAMP_URL=
NEXT_PUBLIC_RAMP_ASSET=
