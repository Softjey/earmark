# localnet | devnet
NEXT_PUBLIC_CLUSTER=devnet
# optional, defaults to the public RPC of the cluster
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TPLN_MINT=
# Devnet ePLN faucet (T13). JSON byte array of the dedicated faucet key; server-side only, never commit.
# Generate with: pnpm tsx scripts/setup-faucet.ts
FAUCET_SECRET_KEY=
# optional: whole ePLN per request (default 100, max 1000) and cap on token accounts the faucet may open (default 40)
FAUCET_AMOUNT=
FAUCET_MAX_NEW_ACCOUNTS=
